{
	"schemaVersion": 1,
	"id": "simple-tombstone",
	"version": "${version}",
	"name": "Simple Tombstone",
	"description": "在玩家死亡时生成物品箱保存掉落物",
	"authors": ["fly"],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/simple-tombstone/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.simpletombstone.SimpleTombstone"
		],
		"client": [
			"com.simpletombstone.SimpleTombstoneClient"
		],
		"fabric-datagen": [
			"com.simpletombstone.SimpletombstoneDataGenerator"
		]
	},
	"mixins": [
		"simple-tombstone.mixins.json",
		{
			"config": "simple-tombstone.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}